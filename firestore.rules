rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['Admin', 'Staff'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isOperator();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['Staff', 'Student', 'Parent']
        && request.resource.data.createdAt == request.time;

      allow update: if isOperator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName == resource.data.displayName;

      allow delete: if false;
    }

    match /dashboardData/{userId} {
      allow read: if isOwner(userId) || isOperator();
      allow create, update: if isOperator();
      allow delete: if false;
    }

    match /faculties/{facultyId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }
  }
}
