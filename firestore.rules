rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['Admin', 'Staff'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'Student';
    }

    function isParent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'Parent';
    }

    function parentLinkPath(parentUid, studentUid) {
      return /databases/$(database)/documents/parentLinks/$(parentUid + '_' + studentUid);
    }

    function isLinkedParentOf(studentUid) {
      return signedIn()
        && exists(parentLinkPath(request.auth.uid, studentUid));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isOperator();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['Staff', 'Student', 'Parent']
        && request.resource.data.createdAt == request.time;

      allow update: if isOperator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName == resource.data.displayName;

      allow delete: if false;
    }

    match /dashboardData/{userId} {
      allow read: if isOwner(userId) || isOperator() || isLinkedParentOf(userId);
      allow create, update: if isOperator();
      allow delete: if false;
    }

    match /faculties/{facultyId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isOperator();
    }

    match /parentInvites/{inviteId} {
      allow get: if true;
      allow list: if isOperator()
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'studentUid',
          'studentName',
          'guardianEmail',
          'status',
          'createdAt',
          'expiresAt'
        ]);

      allow update: if isStudent()
          && resource.data.studentUid == request.auth.uid
        || (signedIn()
          && request.auth.token.email != null
          && resource.data.guardianEmail == request.auth.token.email
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedByUid == request.auth.uid);

      allow delete: if isOperator()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
    }

    match /parentLinks/{linkId} {
      allow read: if isOperator()
        || (signedIn() && resource.data.parentUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);

      allow create: if isParent()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.parentEmail == request.auth.token.email
        && request.resource.data.keys().hasAll([
          'parentUid',
          'parentEmail',
          'parentName',
          'studentUid',
          'studentName',
          'sourceInviteId',
          'createdAt'
        ]);

      allow update, delete: if isOperator()
        || (isStudent() && resource.data.studentUid == request.auth.uid)
        || (isParent() && resource.data.parentUid == request.auth.uid);
    }
  }
}
